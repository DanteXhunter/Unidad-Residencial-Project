# Copia este archivo como .env y rellena los valores.
# cp .env.example .env

# ---------------------------------------------------------------------------
# Base de datos
# ---------------------------------------------------------------------------
# Postgres local (desarrollo):
DATABASE_URL=postgresql+psycopg://localhost:5432/residencial_dev

# Supabase (producción / entrega):
#   Dashboard de Supabase -> Project Settings -> Database -> Connection string
#
#   Usa el "Session pooler" (puerto 5432) porque Alembic necesita transacciones
#   largas y sentencias preparadas:
# DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
#
#   Si usas el "Transaction pooler" (puerto 6543), la app desactiva
#   automáticamente las sentencias preparadas, pero Alembic puede fallar.
#   En ese caso corre las migraciones apuntando al puerto 5432.

# ---------------------------------------------------------------------------
# Seguridad
# ---------------------------------------------------------------------------
# Llave para firmar la cookie de sesión. Genera una nueva con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambia-esta-llave-por-una-generada-aleatoriamente

# Duración de la sesión en segundos (8 horas por defecto).
SESSION_MAX_AGE=28800

# Marca la cookie de sesión como "secure" (solo HTTPS). Ponlo en true al desplegar.
COOKIE_SECURE=false
